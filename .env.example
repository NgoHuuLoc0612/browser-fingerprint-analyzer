# ─────────────────────────────────────────────
# Browser Fingerprint Analyzer — Environment
# Copy to .env and fill in your values
# ─────────────────────────────────────────────

# ── Backend
NODE_ENV=development
PORT=3001
HOST=0.0.0.0

# PostgreSQL 17
# WSL2: use the Windows host IP
# (ip route show default | awk '{print $3}')
# Native: use localhost
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/fingerprint_db

# Redis / Memurai
# WSL2: use the Windows host IP
# (ip route show default | awk '{print $3}')
# Native: use localhost
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# ── Frontend
NUXT_PUBLIC_API_URL=http://localhost:3001